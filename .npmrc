legacy-peer-deps=true
# Skip Chromium download during install — puppeteer is only used locally by
# the capture-*.mjs scripts for case-study screenshots. Vercel never runs
# them, and downloading Chromium (~170 MB) on every install fails / times
# out the deploy. Run `PUPPETEER_SKIP_DOWNLOAD=false npx puppeteer browsers
# install chrome` locally when you actually need to capture.
puppeteer_skip_download=true
